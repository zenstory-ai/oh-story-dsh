{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals", "@playwright/test"]
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "scripts/**/*.ts",
    "*.ts"
  ],
  "exclude": ["**/dist/**", "**/lib/**", "**/node_modules/**", "packages/knowledge/**", "docs/blueprint/**"]
}
